{
    "manifest_version": 3,
    "name": "unidocu F8·F9 단축키 맞춤",
    "short_name": "F8·F9 맞춤",
    "version": "1.0.0",
    "description": "unidocu 솔루션 버전마다 다른 F8(디버그)·F9 배치를 내가 정한 키로 자동으로 맞춥니다.",
    "icons": {
        "16": "icons/icon16.png",
        "32": "icons/icon32.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "permissions": [
        "storage",
        "scripting",
        "tabs"
    ],
    "optional_host_permissions": [
        "*://*/*"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_title": "unidocu F8·F9 단축키 맞춤",
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icons/icon16.png",
            "32": "icons/icon32.png",
            "48": "icons/icon48.png"
        }
    }
}
