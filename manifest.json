{
    "manifest_version": 3,
    "name": "functionKeyCompat",
    "version": "1.0.0",
    "description": "unidocu 솔루션 버전마다 다른 펑션키(F8·F9 등) 배치를 사이트별로 맞춥니다.",
    "permissions": ["storage", "scripting", "tabs"],
    "optional_host_permissions": ["*://*/*"],
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_title": "functionKeyCompat",
        "default_popup": "popup.html"
    }
}
